   "source": [
    "# --- PRUEBA MANUAL DEL CHATBOT ---\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"\\n--- PoC Chatbot EcoMarket Retail ---\")\n",
    "    print(\"Escribe 'salir' para terminar.\\n\")\n",
    "    \n",
    "    while True:\n",
    "        # Añadimos .strip() para eliminar espacios en blanco accidentales\n",
    "        texto = input(\"Usuario: \").strip() \n",
    "        \n",
    "        if texto.lower() == 'salir':\n",
    "            break\n",
    "            \n",
    "        # NUEVO: Si el usuario pulsa Enter sin escribir nada, volvemos a preguntar\n",
    "        if not texto:\n",
    "            print(\"🤖 Bot [Por favor, escribe una pregunta válida para que pueda ayudarte]\")\n",
    "            print(\"-\" * 40)\n",
    "            continue # Salta el resto del código y vuelve al inicio del bucle\n",
    "            \n",
    "        intencion, score = procesar_mensaje(texto)\n",
    "        \n",
    "        # Lógica básica: Si el modelo no está muy seguro (< 40%), derivamos a humano\n",
    "        if score < 0.40:\n",
    "            intencion = \"Hablar con soporte humano\"\n",
    "            \n",
    "        print(f\"🤖 Bot [Intención detectada: {intencion} | Confianza: {score:.2f}]\")\n",
    "        print(\"-\" * 40)"
   ]
  }
 ],
